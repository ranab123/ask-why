# Copy to .env (./setup.sh does this for you) and fill in. .env is git-ignored.

# Required for the teacher and the observer: an OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: pin one ServiceNow instance instead of a random one from the WorkArena pool on every run.
# Leave these commented out unless you fill in all three; `python scripts/check_setup.py --pin` does it for you.
# SNOW_INSTANCE_URL=
# SNOW_INSTANCE_UNAME=admin
# SNOW_INSTANCE_PWD=
